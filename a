#cloud-config
autoinstall:
  version: 1

  # Keep Ubuntu's normal installer screens interactive. This file only supplies
  # defaults plus a small post-install bootstrap. Disk layout, encryption,
  # Wi-Fi, username and password stay under your control.
  interactive-sections:
    - "*"

  locale: de_DE.UTF-8
  keyboard:
    layout: de
    variant: ""
    toggle: null
  timezone: Europe/Berlin

  # Keep the installer lean and reliable. All optional development/creative
  # software is installed after the first boot instead of while files are copied.
  updates: security

  late-commands:
    - install -d -m 0755 /target/usr/local/sbin /target/usr/local/bin /target/etc/systemd/system /target/etc/xdg/autostart
    - curl -fsSL https://raw.githubusercontent.com/Cardegor/u/main/r -o /target/usr/local/sbin/surface-ai-root-firstboot
    - chmod 0755 /target/usr/local/sbin/surface-ai-root-firstboot
    - curl -fsSL https://raw.githubusercontent.com/Cardegor/u/main/f -o /target/usr/local/bin/surface-ai-user-setup
    - chmod 0755 /target/usr/local/bin/surface-ai-user-setup
    - |
      cat > /target/etc/systemd/system/surface-ai-root-firstboot.service <<'EOF'
      [Unit]
      Description=Surface AI workstation first-boot bootstrap
      Wants=network-online.target
      After=network-online.target snapd.seeded.service
      ConditionPathExists=!/var/lib/surface-ai-bootstrap.done

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/surface-ai-root-firstboot
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
      EOF
    - |
      cat > /target/etc/xdg/autostart/surface-ai-user-setup.desktop <<'EOF'
      [Desktop Entry]
      Type=Application
      Name=Surface AI Workstation Setup
      Comment=Apply GNOME theme, extensions and developer user configuration
      Exec=/usr/local/bin/surface-ai-user-setup
      Terminal=false
      X-GNOME-Autostart-enabled=true
      OnlyShowIn=GNOME;Unity;
      EOF
    - curtin in-target --target=/target -- systemctl enable surface-ai-root-firstboot.service

  shutdown: reboot
