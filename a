#cloud-config
autoinstall:
  version: 1

  # Keep all normal installer screens visible. In particular, disk layout,
  # encryption, Wi-Fi, account name and password remain under your control.
  interactive-sections:
    - "*"

  locale: de_DE.UTF-8
  keyboard:
    layout: de
    variant: ""
    toggle: null
  timezone: Europe/Berlin

  codecs:
    install: true

  drivers:
    install: true

  oem:
    install: auto

  updates: all

  packages:
    - ca-certificates
    - curl
    - wget
    - git
    - gh
    - build-essential
    - xz-utils
    - jq
    - unzip
    - zip
    - rsync
    - ripgrep
    - nodejs
    - npm
    - docker.io
    - docker-compose-v2
    - python3
    - python3-venv
    - python3-pip
    - python3-dev
    - pipx
    - sqlite3
    - postgresql-client
    - ffmpeg
    - imagemagick
    - gnome-tweaks
    - gnome-shell-extension-manager
    - gnome-shell-extension-user-theme
    - gnome-shell-extension-workspace-indicator
    - gnome-shell-extension-system-monitor
    - sassc
    - libglib2.0-dev
    - libglib2.0-dev-bin
    - libxml2-utils
    - gettext
    - libnotify-bin
    - fonts-inter

  snaps:
    - name: code
      channel: stable
      classic: true
    - name: blender
      channel: stable
      classic: true

  late-commands:
    - install -d -m 0755 /target/usr/local/sbin /target/usr/local/bin /target/etc/systemd/system /target/etc/xdg/autostart
    - curl -fsSL https://raw.githubusercontent.com/Cardegor/u/main/r -o /target/usr/local/sbin/surface-ai-root-firstboot
    - chmod 0755 /target/usr/local/sbin/surface-ai-root-firstboot
    - curl -fsSL https://raw.githubusercontent.com/Cardegor/u/main/f -o /target/usr/local/bin/surface-ai-user-setup
    - chmod 0755 /target/usr/local/bin/surface-ai-user-setup
    - |
      cat > /target/etc/systemd/system/surface-ai-root-firstboot.service <<'EOF'
      [Unit]
      Description=Surface AI workstation first-boot bootstrap
      Wants=network-online.target
      After=network-online.target snapd.seeded.service
      ConditionPathExists=!/var/lib/surface-ai-bootstrap.done

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/surface-ai-root-firstboot
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
      EOF
    - |
      cat > /target/etc/xdg/autostart/surface-ai-user-setup.desktop <<'EOF'
      [Desktop Entry]
      Type=Application
      Name=Surface AI Workstation Setup
      Comment=Apply GNOME theme, extensions and developer user configuration
      Exec=/usr/local/bin/surface-ai-user-setup
      Terminal=false
      X-GNOME-Autostart-enabled=true
      OnlyShowIn=GNOME;Unity;
      EOF
    - curtin in-target --target=/target -- systemctl enable surface-ai-root-firstboot.service

  shutdown: reboot
